<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>linksta</AssemblyName>
    <RootNamespace>Linksta</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Synchronisiert ILIAS-Kurse per WebDAV auf den lokalen Rechner.</Description>

    <!-- Als globales dotnet-Tool installierbar: dotnet tool install -g -add-source ./nupkg linksta -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>linksta</ToolCommandName>
    <PackageId>linksta</PackageId>
    <PackageOutputPath>../../nupkg</PackageOutputPath>

    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Linksta.Tests" />
  </ItemGroup>

</Project>
